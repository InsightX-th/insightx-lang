msgstr "ประเภทเนื้อหานี้ไม่ได้เปิดให้แปล"

#: includes/class-isxl-duplicator.php
msgid "This taxonomy is not translated."
msgstr "หมวดหมู่นี้ไม่ได้เปิดให้แปล"

